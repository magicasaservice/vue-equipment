{
  "name": "@maas/vue-equipment",
  "description": "Our Frontend Toolkit, Free and Open Source",
  "version": "1.0.0-beta.83",
  "contributors": [
    {
      "name": "Robin Scholz",
      "url": "https://github.com/robinscholz"
    },
    {
      "name": "Christoph Jeworutzki",
      "url": "https://github.com/ChristophJeworutzki"
    }
  ],
  "devDependencies": {
    "@floating-ui/vue": "catalog:",
    "@maas/config": "^1.16.1",
    "@maas/magic-timer": "catalog:",
    "@maas/mirror": "catalog:",
    "@maas/vue-autosize": "catalog:",
    "@maas/vue-primitive": "catalog:",
    "@nuxt/kit": "catalog:",
    "@release-it/bumper": "^7.0.6",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.11",
    "@vueuse/core": "catalog:",
    "@vueuse/integrations": "catalog:",
    "defu": "catalog:",
    "eslint": "^10.9.1",
    "focus-trap": "catalog:",
    "hls.js": "catalog:",
    "luxon": "catalog:",
    "mitt": "catalog:",
    "motion": "catalog:",
    "nuxt": "catalog:",
    "playwright": "^1.62.1",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "release-it": "^19.2.4",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "universal-cookie": "catalog:",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue": "catalog:",
    "wheel-gestures": "catalog:"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./nuxt": {
      "types": "./dist/nuxt/types.d.mts",
      "import": "./dist/nuxt/module.mjs"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*/index.d.ts",
      "import": "./dist/plugins/*/index.mjs"
    },
    "./plugins/MagicPlayer/css/*.css": "./dist/plugins/MagicPlayer/src/css/*.css",
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/css/*.css": "./dist/utils/css/*.css"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@floating-ui/vue": "^1 || ^2",
    "@maas/magic-timer": "^1",
    "@maas/vue-autosize": "^1",
    "@maas/vue-primitive": "^1.4",
    "@nuxt/kit": ">=3",
    "@vueuse/core": ">=12",
    "@vueuse/integrations": ">=12",
    "defu": "^6",
    "focus-trap": "^7 || ^8",
    "hls.js": "^1",
    "luxon": "^3",
    "mitt": "^3",
    "motion": "^12 || ^13",
    "nuxt": ">=3.15",
    "universal-cookie": "^7 || ^8",
    "vue": "^3.5",
    "wheel-gestures": "^2.2.48"
  },
  "peerDependenciesMeta": {
    "@floating-ui/vue": {
      "optional": true
    },
    "@maas/magic-timer": {
      "optional": true
    },
    "@maas/vue-autosize": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "@vueuse/integrations": {
      "optional": true
    },
    "focus-trap": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    },
    "luxon": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "universal-cookie": {
      "optional": true
    },
    "wheel-gestures": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:nuxt": "turbo run dev --filter=nuxt",
    "build": "turbo run build --filter=!playground",
    "build:types": "turbo run build:types",
    "build:docs": "pnpm exec playwright install chromium --with-deps && turbo run build --filter=docs",
    "tokens": "pnpm dlx @maas/mirror@beta tokens --skip true && pnpm dlx @maas/mirror@beta tailwind --skip true",
    "preview:docs": "turbo run preview --filter=docs",
    "update:metadata": "turbo run update --filter=metadata",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "uninstall": "pnpm dlx rimraf --glob ./**/node_modules --glob ./**/pnpm-lock.yaml",
    "release": "turbo run t:release && release-it",
    "update:deps": "pnpm dlx taze -r -w",
    "update:deps:major": "pnpm dlx taze major -r -w"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "typescript": "catalog:"
    },
    "onlyBuiltDependencies": [
      "@bundled-es-modules/glob",
      "@parcel/watcher",
      "esbuild",
      "style-dictionary",
      "vue-demi"
    ]
  }
}
