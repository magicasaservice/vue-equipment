{
  "name": "nuxt",
  "version": "1.0.0-beta.82",
  "contributors": [
    {
      "name": "Robin Scholz",
      "url": "https://github.com/robinscholz"
    },
    {
      "name": "Christoph Jeworutzki",
      "url": "https://github.com/ChristophJeworutzki"
    }
  ],
  "dependencies": {
    "composables": "workspace:*",
    "plugins": "workspace:*",
    "utils": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/devtools": "1.7.0",
    "@nuxt/kit": "catalog:",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/test-utils": "^3.23.0",
    "nuxt": "catalog:",
    "vitest": "^4.1.11"
  },
  "private": true,
  "scripts": {
    "build": "pnpm dlx nuxi prepare playground && nuxt-module-build build --outDir ../../dist/nuxt",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "type": "module",
  "sideEffects": false
}
